#!/usr/bin/env bash
set -euo pipefail

export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y ca-certificates curl gnupg lsb-release

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

echo \
  "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
  https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

mkdir -p /opt/zot/data
cat > /opt/zot/config.json <<'EOF'
{
  "distSpecVersion": "1.1.0",
  "storage": {
    "rootDirectory": "/var/lib/registry"
  },
  "http": {
    "address": "0.0.0.0",
    "port": "5000"
  },
  "log": {
    "level": "info"
  }
}
EOF

docker rm -f zot >/dev/null 2>&1 || true
docker run -d \
  --name zot \
  --restart unless-stopped \
  -p 5000:5000 \
  -v /opt/zot/config.json:/etc/zot/config.json:ro \
  -v /opt/zot/data:/var/lib/registry \
  ghcr.io/project-zot/zot-linux-amd64:latest serve /etc/zot/config.json

if [[ -n "${zot_domain}" && -n "${zot_email}" ]]; then
  cat > /opt/Caddyfile <<EOF
${zot_domain} {
  tls ${zot_email}
  reverse_proxy 127.0.0.1:5000
}
EOF

  docker rm -f caddy >/dev/null 2>&1 || true
  docker run -d \
    --name caddy \
    --restart unless-stopped \
    -p 80:80 -p 443:443 \
    -v /opt/Caddyfile:/etc/caddy/Caddyfile:ro \
    -v caddy_data:/data \
    -v caddy_config:/config \
    caddy:2
fi
